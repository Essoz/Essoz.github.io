<!doctype html>
<html lang="{{ site.lang }}">
  <head>
    {% include head.liquid %}
  </head>

  <body class="home-page">
    <a class="home-skip-link" href="#main-content">Skip to content</a>

    <header class="home-header">
      <div class="home-header__rule" aria-hidden="true"></div>
      <div class="home-frame home-header__inner">
        <a class="home-name" href="{{ '/' | relative_url }}" aria-label="Yuxuan Jiang, home" aria-current="page">Yuxuan Jiang</a>
      </div>
    </header>

    <main id="main-content" class="home-frame home-main" tabindex="-1">
      <div class="home-layout">
        {% assign profile_image_path = page.profile.image | prepend: '/assets/img/' %}
        <img
          class="home-portrait"
          src="{{ profile_image_path | relative_url | bust_file_cache }}"
          alt="{{ page.profile.alt }}"
          width="705"
          height="705"
          fetchpriority="high"
        >

        <section class="home-hero" aria-labelledby="home-introduction">
          <div class="home-hero__copy">
            <h1 id="home-introduction">{{ page.statement }}</h1>
          </div>
        </section>

        <aside class="home-profile-rail" aria-label="Profile and links">
          <p class="home-role">
            <span>{{ page.role }}</span>
            <a href="{{ page.affiliation_url }}">{{ page.affiliation }}</a>
          </p>

          <div class="home-profile-rail__rule" aria-hidden="true"></div>

          <nav class="home-profile-rail__nav" aria-label="Primary navigation">
            <ul>
              {% for item in page.home_nav %}
                <li><a href="{{ item.url | relative_url }}">{{ item.label }}</a></li>
              {% endfor %}
            </ul>
          </nav>

          <nav class="home-profile-rail__profiles" aria-label="Contact and profiles">
            <a href="mailto:{{ page.email | encode_email }}">E-mail</a>
            <a href="{{ page.scholar_url }}" rel="me">Google Scholar</a>
            <a href="{{ page.github_url }}" rel="me">GitHub</a>
          </nav>
        </aside>

        <div class="home-content">
          <section class="home-research" aria-labelledby="lead-research-heading">
            <h2 id="lead-research-heading">Lead-authored research</h2>
            <div class="home-research__list">
              {% for work in page.lead_research %}
                <article class="home-research__item">
                  <p class="home-research__meta">{{ work.year }} <span aria-hidden="true">·</span> {{ work.venue }}</p>
                  <div class="home-research__copy">
                    <h3><a href="{{ work.url | relative_url }}">{{ work.title }}</a></h3>
                    <p>{{ work.description }}</p>
                  </div>
                </article>
              {% endfor %}
            </div>
          </section>

          <section class="home-recent" aria-labelledby="recent-heading">
            <h2 id="recent-heading">Recent</h2>
            <ul>
              {% for item in page.recent %}
                <li><time datetime="{{ item.datetime }}">{{ item.date }}</time><span aria-hidden="true">·</span><span>{{ item.text }}</span></li>
              {% endfor %}
            </ul>
            <p class="home-recent__advisor">Advised by <a href="{{ page.advisor_url }}">{{ page.advisor_name }}</a>.</p>
          </section>
        </div>
      </div>
    </main>

    <footer class="home-frame home-footer">
      <p class="home-footer__copyright">&copy; {{ site.time | date: '%Y' }} Yuxuan Jiang</p>
    </footer>
  </body>
</html>
